{
  "name": "fullstack-milestone",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "start": "tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
