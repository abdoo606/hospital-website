# ------------------------------------------------------------------
# Copy to .env and adjust for the deployment. Never commit .env.
# ------------------------------------------------------------------

# --- Server ---
PORT=4000
HOST=0.0.0.0
NODE_ENV=production

# Set to 1 when the app runs behind nginx / a load balancer so that
# rate limiting and the audit log record the real client IP.
TRUST_PROXY=1

# --- Sessions ---
# 32+ random characters. Generate with:  openssl rand -base64 48
# If unset, a secret is generated once and stored in server/data/.session-secret
SESSION_SECRET=

# lax   → hospital site served from its own domain (recommended)
# none  → embedded in another site's iframe (patients portals, preview panes)
COOKIE_SAMESITE=lax

# --- Security ---
# Extra origins allowed to send state-changing API requests, comma separated.
# Use a leading dot to allow a whole domain, e.g. .hospitalgroup.com
ALLOWED_ORIGINS=

# --- Database ---
# Absolute paths, or leave blank for ./server/data
# DATA_DIR=/var/lib/hospital-cms
# DB_FILE=/var/lib/hospital-cms/hospital.db

# --- First-run seed (only used by `npm run db:seed`) ---
ADMIN_NAME=Hospital Administrator
ADMIN_EMAIL=admin@meridianhospital.com
ADMIN_PASSWORD=Meridian#2026

# --- Development only ---
# Disables login/booking rate limits so automated tests can run.
# Ignored when NODE_ENV=production.
# RATE_LIMIT_DISABLED=1
