{
  "name": "private-hospital-website",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Premium English hospital website + patient enquiry database with a staff admin panel",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "node server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "NODE_ENV=production node server/index.js",
    "db:seed": "node server/seed.js",
    "db:seed:demo": "node server/seed.js --demo",
    "db:reset": "node server/seed.js --reset --force",
    "db:backup": "node scripts/backup.mjs",
    "test:api": "node scripts/smoke-test.mjs",
    "dev:api:test": "RATE_LIMIT_DISABLED=1 node server/index.js"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.7",
    "express": "^4.22.3",
    "multer": "^2.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.2.0",
    "vite": "^7.3.7"
  }
}
